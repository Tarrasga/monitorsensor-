<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07090e">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Botão discreto de configurações de IP -->
    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="#66101722"
        android:src="@android:drawable/ic_menu_preferences"
        android:contentDescription="Definições IP"
        android:alpha="0.4" />

    <!-- Ecrã de Erro com botão de reconectar -->
    <FrameLayout
        android:id="@+id/errorOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0a0d14"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SMARTCOOL MOBILE"
                android:textColor="#10b981"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/errorText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A aguardar ligação ao PC..."
                android:textColor="#94a3b8"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tentar Novamente"
                android:backgroundTint="#10b981"
                android:textColor="#ffffff"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnChangeIp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mudar IP do PC"
                android:backgroundTint="#334155"
                android:textColor="#cbd5e1" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
